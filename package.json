{
  "name": "cloudflare-demo-shop",
  "version": "2.0.0",
  "description": "Cloudflare product and feature demo site — Astro static site on Cloudflare Pages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:full": "astro build && wrangler pages dev dist --live-reload",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:aboutme-rag": "wrangler deploy --config aboutme-rag-worker/wrangler.toml",
    "deploy:docs-sync": "wrangler deploy --config docs-sync-worker/wrangler.toml",
    "deploy": "astro build && wrangler pages deploy dist",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.1.1",
    "js-yaml": "^4.1.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.91.0",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "hono": "^4.12.22"
  }
}
