---
// AI Gateway demo — compares Cloudflare-hosted Workers AI models with
// OpenRouter models while keeping AI Gateway as the single control plane.
---

<div x-data="aiGatewayDemo()" class="space-y-4">
  <div class="demo-panel safe">
    <h3>One gateway, multiple model backends</h3>
    <p class="text-sm text-gray-700 mt-2">
      Choose a model hosted on Cloudflare Workers AI or accessed through
      OpenRouter. Every request still passes through the same Cloudflare AI
      Gateway for caching, rate limiting, guardrails, and request logging.
    </p>
    <p class="text-xs text-gray-500 mt-2">
      Route:
      <code class="bg-silver-50 px-1.5 py-0.5 rounded" x-text="routeLabel"></code>
    </p>
  </div>

  <div class="demo-panel safe flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3>Identity-aware access</h3>
      <p class="mt-1 text-sm text-gray-700">
        Authenticate to attach your verified Access identity to gateway logs and spend controls.
      </p>
    </div>
    <div class="shrink-0">
      <a
        href="https://aig.remydemo.com/compat/chat/completions"
        target="_blank"
        rel="noopener noreferrer"
        @click="authStarted = true"
        class="btn-secondary inline-flex"
      >
        Authenticate to AI Gateway
      </a>
      <p x-show="authStarted" class="mt-2 max-w-xs text-xs text-gray-500">
        Complete Access in the new tab, close it after sign-in, then send your prompt here.
      </p>
    </div>
  </div>

  <div class="space-y-2">
    <label for="ai-gateway-model" class="text-xs font-semibold uppercase tracking-wide text-gray-600">
      Model backend
    </label>
    <select id="ai-gateway-model" x-model="selectedModel" :disabled="loading" class="demo-input">
      <optgroup label="Cloudflare Workers AI">
        <option value="workers-llama-3-3-70b">Llama 3.3 70B</option>
        <option value="workers-kimi-k2-6">Kimi K2.6</option>
        <option value="workers-deepseek-v4-flash">DeepSeek V4 Flash</option>
      </optgroup>
      <optgroup label="OpenRouter">
        <option value="openrouter-gpt-5-4-mini">GPT-5.4 Mini</option>
        <option value="openrouter-gpt-5-6-luna">GPT-5.6 Luna</option>
        <option value="openrouter-gemini-3-8-flash">Gemini 3.8 Flash</option>
        <option value="openrouter-kimi-k3">Kimi K3</option>
        <option value="openrouter-glm-5-3-flash">GLM 5.3 Flash</option>
        <option value="openrouter-glm-5-2-free">GLM 5.2 (free)</option>
        <option value="openrouter-claude-haiku-4-5">Claude Haiku 4.5</option>
        <option value="openrouter-claude-sonnet-5">Claude Sonnet 5</option>
      </optgroup>
    </select>
    <div class="flex flex-wrap gap-2 text-xs">
      <span class="rounded-full bg-orange-50 px-2.5 py-1 font-semibold text-orange-700" x-text="selectedProvider"></span>
      <span class="rounded-full bg-silver-50 px-2.5 py-1 font-mono text-gray-600" x-text="selectedModelId"></span>
    </div>
  </div>

  <div class="space-y-2">
    <label class="text-xs text-gray-600">Send a test prompt through the gateway</label>
    <textarea
      x-model="prompt"
      class="demo-input"
      rows="2"
      maxlength="4000"
      placeholder="What's the difference between Workers and Lambda?"
    ></textarea>
  </div>

  <div class="flex gap-3 items-center">
    <button type="button" @click="send" :disabled="loading || !prompt.trim()" class="btn-primary">
      <span x-show="!loading">Send through AI Gateway</span>
      <span x-show="loading">Routing...</span>
    </button>
    <span class="text-sm text-gray-500" x-show="cachedHit" x-text="'⚡ Cached response (no provider charge)'"></span>
  </div>

  <div x-show="response" x-transition class="demo-panel safe">
    <div class="flex items-baseline gap-3 mb-2">
      <h3 class="!mb-0" x-text="responseHeading"></h3>
      <span class="text-xs text-gray-500" x-text="'Latency: ' + latencyMs + ' ms'"></span>
    </div>
    <div class="whitespace-pre-wrap text-sm leading-relaxed" x-text="response"></div>
  </div>

  <div x-show="error" x-transition class="demo-panel danger">
    <h3 x-text="authRequired ? 'Authentication required' : 'Gateway error'"></h3>
    <p class="text-sm" x-text="error"></p>
    <a
      x-show="authRequired"
      href="https://aig.remydemo.com/compat/chat/completions"
      target="_blank"
      rel="noopener noreferrer"
      @click="authStarted = true"
      class="btn-secondary mt-3 inline-flex"
    >
      Open Access sign-in
    </a>
  </div>

  <p class="text-xs text-gray-500">
    Tip: send the same prompt twice. If AI Gateway response caching is on
    for this route, the second call returns much faster.
  </p>
</div>

<script is:inline>
  function aiGatewayDemo() {
    return {
      prompt: "What's the difference between Workers and Lambda?",
      selectedModel: "workers-llama-3-3-70b",
      responseModel: "",
      response: "",
      error: "",
      authRequired: false,
      authStarted: false,
      loading: false,
      latencyMs: 0,
      lastPromptLatency: null,
      lastPrompt: null,
      cachedHit: false,

      models: {
        "workers-llama-3-3-70b": { provider: "Workers AI", label: "Llama 3.3 70B", id: "@cf/meta/llama-3.3-70b-instruct-fp8-fast", requestModel: "workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast", endpoint: "compat/chat/completions" },
        "workers-kimi-k2-6": { provider: "Workers AI", label: "Kimi K2.6", id: "@cf/moonshotai/kimi-k2.6", requestModel: "workers-ai/@cf/moonshotai/kimi-k2.6", endpoint: "compat/chat/completions" },
        "workers-deepseek-v4-flash": { provider: "Workers AI", label: "DeepSeek V4 Flash", id: "@cf/deepseek-ai/deepseek-v4-flash-0731", requestModel: "workers-ai/@cf/deepseek-ai/deepseek-v4-flash-0731", endpoint: "compat/chat/completions" },
        "openrouter-gpt-5-4-mini": { provider: "OpenRouter", label: "GPT-5.4 Mini", id: "openai/gpt-5.4-mini", requestModel: "openai/gpt-5.4-mini", endpoint: "openrouter/v1/chat/completions" },
        "openrouter-gpt-5-6-luna": { provider: "OpenRouter", label: "GPT-5.6 Luna", id: "openai/gpt-5.6-luna", requestModel: "openai/gpt-5.6-luna", endpoint: "openrouter/v1/chat/completions" },
        "openrouter-gemini-3-8-flash": { provider: "OpenRouter", label: "Gemini 3.8 Flash", id: "google/gemini-3.8-flash", requestModel: "google/gemini-3.8-flash", endpoint: "openrouter/v1/chat/completions" },
        "openrouter-kimi-k3": { provider: "OpenRouter", label: "Kimi K3", id: "moonshotai/kimi-k3", requestModel: "moonshotai/kimi-k3", endpoint: "openrouter/v1/chat/completions" },
        "openrouter-glm-5-3-flash": { provider: "OpenRouter", label: "GLM 5.3 Flash", id: "z-ai/glm-5.3-flash", requestModel: "z-ai/glm-5.3-flash", endpoint: "openrouter/v1/chat/completions" },
        "openrouter-glm-5-2-free": { provider: "OpenRouter", label: "GLM 5.2 (free)", id: "z-ai/glm-5.2:free", requestModel: "z-ai/glm-5.2:free", endpoint: "openrouter/v1/chat/completions" },
        "openrouter-claude-haiku-4-5": { provider: "OpenRouter", label: "Claude Haiku 4.5", id: "anthropic/claude-haiku-4.5", requestModel: "anthropic/claude-haiku-4.5", endpoint: "openrouter/v1/chat/completions" },
        "openrouter-claude-sonnet-5": { provider: "OpenRouter", label: "Claude Sonnet 5", id: "anthropic/claude-sonnet-5", requestModel: "anthropic/claude-sonnet-5", endpoint: "openrouter/v1/chat/completions" },
      },

      get selectedProvider() {
        return this.models[this.selectedModel]?.provider ?? "";
      },

      get selectedModelId() {
        return this.models[this.selectedModel]?.id ?? "";
      },

      get routeLabel() {
        const upstream = this.selectedProvider === "OpenRouter"
          ? "OpenRouter → " + this.selectedModelId
          : "Workers AI → " + this.selectedModelId;
        return "browser → aig.remydemo.com → AI Gateway → " + upstream;
      },

      get responseHeading() {
        return this.responseModel ? "Response from " + this.responseModel : "Response";
      },

      async send() {
        if (!this.prompt.trim()) return;
        this.loading = true;
        this.response = "";
        this.responseModel = "";
        this.error = "";
        this.authRequired = false;
        this.cachedHit = false;

        const requestModel = this.selectedModel;
        const model = this.models[requestModel];
        const start = performance.now();
        try {
          const res = await fetch(`https://aig.remydemo.com/${model.endpoint}`, {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              model: model.requestModel,
              messages: [{ role: "user", content: this.prompt }],
              stream: false,
            }),
          });
          if (res.status === 401 || res.status === 403) {
            this.authRequired = true;
            throw new Error("Authenticate with Cloudflare Access in the new tab, then return here and retry your prompt.");
          }
          if (res.redirected || res.headers.get("content-type")?.includes("text/html")) {
            this.authRequired = true;
            throw new Error("Your Cloudflare Access session is missing or expired. Authenticate in the new tab, then retry your prompt.");
          }
          const responseText = await res.text();
          let data;
          try {
            data = JSON.parse(responseText);
          } catch {
            const summary = responseText
              .replace(/<[^>]*>/g, " ")
              .replace(/\s+/g, " ")
              .trim()
              .slice(0, 240);
            throw new Error(summary
              ? `Gateway returned HTTP ${res.status}: ${summary}`
              : `Gateway returned HTTP ${res.status}`);
          }
          if (!res.ok) {
            const details = data.error?.metadata?.raw
              || data.error?.message
              || data.details
              || (typeof data.error === "string" ? data.error : "")
              || `Gateway returned HTTP ${res.status}`;
            throw new Error(details);
          }
          this.response = data.choices?.[0]?.message?.content || "(empty response)";
          this.responseModel = model.label;

          const elapsed = Math.round(performance.now() - start);
          this.latencyMs = elapsed;

          // Heuristic: if this prompt was just sent and the response came
          // back significantly faster, it likely hit the gateway cache.
          if (
            this.lastPrompt === requestModel + ":" + this.prompt &&
            this.lastPromptLatency !== null &&
            elapsed < this.lastPromptLatency * 0.4
          ) {
            this.cachedHit = true;
          }
          this.lastPrompt = requestModel + ":" + this.prompt;
          this.lastPromptLatency = elapsed;
        } catch (e) {
          if (e instanceof TypeError) {
            this.authRequired = true;
            this.error = "Authenticate with Cloudflare Access in the new tab, then return here and retry your prompt. If you already signed in, refresh this page and try again.";
          } else {
            this.error = e?.message ?? String(e);
          }
        } finally {
          this.loading = false;
        }
      },
    };
  }
</script>
