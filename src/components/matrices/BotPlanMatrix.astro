    detail: "Broader machine-learning detection beyond simple known patterns.",
    values: [false, false, true, true],
  },
  {
    feature: "Domain-specific anomaly detection",
    detail: "Detection tuned to unusual behavior on the customer's own domain.",
    values: [false, false, false, true],
  },
  {
    feature: "Fixed computational challenge",
    detail: "Bot Fight Mode's only response to traffic matching known bot patterns.",
    values: ["Only action", false, false, false],
  },
  {
    feature: "Configure definitely automated traffic",
    detail: "Choose allow, block, or challenge for score-1 automation.",
    values: [false, true, true, "Custom rules"],
  },
  {
    feature: "Configure likely automated traffic",
    detail: "Choose an action for the score 2-29 grouping or write a custom threshold.",
    values: [false, false, true, "Custom rules"],
  },
  {
    feature: "Verified bot and agent controls",
    detail: "Control validated search crawlers, monitoring tools, and signed agents.",
    values: [false, true, true, "Categories / rules"],
  },
  {
    feature: "Path, IP, method, and request-level scope",
    detail: "Apply bot policy to selected traffic instead of one domain-wide configuration.",
    values: ["Domain-wide", "Domain-wide", "Domain-wide", true],
  },
  {
    feature: "WAF Skip exceptions",
    detail: "Exempt approved traffic from Super Bot Fight Mode; Bot Fight Mode cannot be skipped.",
    values: [false, true, true, "Use custom rules"],
  },
  {
    feature: "Static resource protection",
    detail: "Include images, CSS, JavaScript, documents, fonts, and other listed file types.",
    values: [false, true, true, true],
  },
  {
    feature: "JavaScript Detections",
    detail: "Invisible browser-side signals; automatic on Free and optional on paid bot products.",
    values: ["Always on", "Optional", "Optional", "Optional + field"],
  },
  {
    feature: "Optimize for WordPress",
    detail: "Reduces false positives against common WordPress plugin traffic.",
    values: [false, true, true, true],
  },
  {
    feature: "Bot traffic visibility",
    detail: "Free actions appear in Security Events; paid tiers add progressively richer analysis.",
    values: ["Security Events", "24h Bot Report", "72h views / 30d history", "7d views / 30d history"],
  },
  {
    feature: "Granular 1–99 bot score in custom rules",
    detail: "Write rules against the exact score, not just a fixed category.",
    values: [false, false, false, true],
  },
  {
    feature: "Advanced Bot Management fields",
    detail: "JA3/JA4, detection IDs, signed agent, corporate proxy, static-resource, and JS result fields.",
    values: [false, false, false, true],
  },
  {
    feature: "Bot tags in Logpush",
    detail: "Add context about why a request received its bot score.",
    values: [false, false, false, true],
  },
  {
    feature: "Use bot data outside WAF custom rules",
    detail: "Consume or forward signals with Workers, rate limiting, Transform Rules, Snippets, analytics, or logs.",
    values: [false, false, false, true],
