---
// Bot protection plan/feature comparison matrix. Sourced from the current
// product plan and feature pages; prices are intentionally omitted.

interface Tier {
  key: string;
  product: string;
  plan: string;
  blurb: string;
}

const TIERS: Tier[] = [
  {
    key: "bfm",
    product: "Bot Fight Mode",
    plan: "Free",
    blurb: "Domain-wide protection for simple bots and headless browsers. Fixed challenge with no WAF custom-rule exceptions.",
  },
  {
    key: "sbfm-pro",
    product: "Super Bot Fight Mode",
    plan: "Pro",
    blurb: "Configurable actions for definitely automated and verified traffic, plus a 24-hour Bot Report.",
  },
  {
    key: "sbfm-biz",
    product: "Super Bot Fight Mode",
    plan: "Business (or Enterprise without the add-on)",
    blurb: "Adds many sophisticated and likely automated bots, plus the dedicated Bot Analytics dashboard.",
  },
  {
    key: "bm",
    product: "Enterprise Bot Management",
    plan: "Enterprise add-on",
    blurb: "Granular scores, advanced signals, custom rules, richer analytics, and new bot intelligence tools.",
  },
];

// Cell value: `true` = fully supported · `false` = not available ·
// string = supported with a caveat worth calling out.
type Cell = boolean | string;

interface Row {
  feature: string;
  detail: string;
  values: [Cell, Cell, Cell, Cell];
}

const ROWS: Row[] = [
  {
