---

<div class="bot-matrix">
  <p class="text-gray-700 leading-relaxed mb-6">
    Cloudflare provides bot protection on every plan. What changes is
    <strong>how deep the detection goes</strong>, how much
    <strong>control</strong> you get over the action taken, and how much
    <strong>visibility</strong> you have into what got caught.
  </p>

  <!-- ─── Tier cards ─── -->
  <div class="bot-tier-grid">
    {
      TIERS.map((tier) => (
        <div class="bot-tier-card">
          <div class="bot-tier-card-plan">{tier.plan}</div>
          <h3>{tier.product}</h3>
          <p>{tier.blurb}</p>
        </div>
      ))
    }
  </div>

  <!-- ─── Feature matrix ─── -->
  <div class="bot-matrix-scroll">
    <table class="bot-matrix-table">
      <thead>
        <tr>
          <th class="bot-matrix-corner">Feature</th>
          {
            TIERS.map((tier) => (
              <th>
                <span class="block">{tier.product}</span>
                <span class="bot-matrix-plan-tag">{tier.plan}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((row) => (
            <tr>
              <th scope="row">
                <span class="block">{row.feature}</span>
                <span class="bot-matrix-feature-detail">{row.detail}</span>
              </th>
              {
                row.values.map((cell) => (
                  <td>
                    {cell === true && (
                      <span class="bot-matrix-yes" title="Included">
                        ✓
                      </span>
                    )}
                    {cell === false && (
                      <span class="bot-matrix-no" title="Not available">
                        —
                      </span>
                    )}
                    {typeof cell === "string" && (
                      <span class="bot-matrix-partial">{cell}</span>
                    )}
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="bot-matrix-legend">
    <span><span class="bot-matrix-yes">✓</span> Included</span>
    <span><span class="bot-matrix-partial">Label</span> Included, with a caveat</span>
    <span><span class="bot-matrix-no">—</span> Not available</span>
  </div>

  <div class="callout-warning">
    <strong>Free-plan limitation:</strong> Bot Fight Mode has no log mode, custom
    exceptions, or explicit verified-bot control. Review its actions in Security
    Events after enablement. If legitimate automation is challenged, disable it
    or move to Super Bot Fight Mode for configurable actions and WAF Skip exceptions.
  </div>
</div>
