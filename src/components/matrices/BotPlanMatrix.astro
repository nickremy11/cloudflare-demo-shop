    detail: "Early Access fraud signals for login and registration abuse; contact the account team.",
    values: [false, false, false, "Early Access"],
  },
  {
    feature: "AI behavior policies",
    detail: "Allow or block Search, Agent, and Training behavior across the zone or on pages with ads.",
    values: [true, true, true, true],
  },
  {
    feature: "AI Crawl Control",
    detail: "Monitor AI traffic, control individual crawlers, and track robots.txt compliance.",
